# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

# Your Supabase Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon/Public Key (safe for client-side)
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here
SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here

# Your Supabase Service Role Key (KEEP SECRET! Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Mock Backend (for development without Supabase)
# VITE_USE_MOCK_BACKEND=false
